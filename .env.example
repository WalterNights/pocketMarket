# Copiar a .env y rellenar. .env NUNCA se versiona.
#
# REGLA: todo lo que empiece por EXPO_PUBLIC_ acaba DENTRO del bundle de la app,
# que cualquiera puede descomprimir y leer. Si dudas si algo puede ser público,
# no puede. Ver docs/architecture/08-security.md

# --- App (públicas por diseño) ---------------------------------------------
# La clave anon es pública a propósito: lo que limita su poder son las políticas RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Pipeline de ingesta (NUNCA en la app) ---------------------------------
# service_role SALTA RLS: es acceso total a la base de datos.
# Vive solo en secrets de GitHub Actions y en variables de Edge Function.
# Si aparece en cualquier archivo bajo src/, es un incidente de seguridad.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
