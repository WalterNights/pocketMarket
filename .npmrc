# Los ajustes de seguridad de la cadena de suministro viven en pnpm-workspace.yaml
# (allowBuilds, minimumReleaseAge, blockExoticSubdeps, trustPolicy).
# Aquí solo lo que no tiene sitio allí.

# Falla si la versión de Node no cumple "engines". Mejor un error claro al instalar
# que un fallo raro tres horas después.
engine-strict=true

# Nunca instalar desde un registro que no sea el oficial.
registry=https://registry.npmjs.org/

# Las peer deps se instalan automáticamente (default en pnpm 8+); explícito para que
# quede registrado que es intencional.
auto-install-peers=true

# Verifica que node_modules coincide con el lockfile antes de ejecutar cualquier script.
# Evita correr tests o builds contra un árbol desincronizado.
verify-deps-before-run=true
